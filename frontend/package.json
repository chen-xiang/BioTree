{
  "name": "biotree-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "openapi:generate": "openapi-typescript ./openapi/openapi.yaml -o src/api/schema.d.ts",
    "openapi:generate:live": "openapi-typescript http://localhost:8080/v3/api-docs -o src/api/schema.d.ts",
    "typecheck": "vue-tsc -b --pretty false",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 50"
  },
  "dependencies": {
    "marked": "^15.0.12",
    "openapi-fetch": "^0.17.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.10",
    "vue-router": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^3.2.4",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  }
}
